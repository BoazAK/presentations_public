# Préfixe Docker : conteneurs, images et réseau = <STACK_NAME>-<service>
STACK_NAME=gdg-farm-dev
LAB_BIND=127.0.0.1

# insecure | secure | hardened — changer avec : bash scripts/mode.sh <mode>
FARM_MODE=insecure

# Token Bearer de l'API vanne (modes secure et hardened). Valeur de démo.
DEMO_TOKEN=gdg-demo-token

# Générés par scripts/setup.sh s'ils sont vides.
CMD_HMAC_KEY=
MQTT_PASS_SIMULATOR=
MQTT_PASS_DASHBOARD=

# Identifiants « fuités » du scénario hardened (comptes à faibles droits).
LEAK_VIEWER_PASS=ecran-bureau-2026
LEAK_MAINTENANCE_PASS=maintenance-2026
LEAK_SENSOR02_PASS=firmware-capteur-02
